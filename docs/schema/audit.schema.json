{
  "$comment": "secaudit findings.json, schema_version 2. Generated by `python -m secaudit.core.schema_export`; do not edit by hand.",
  "$defs": {
    "AuditInput": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "file_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Count"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "total_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Bytes"
        }
      },
      "title": "AuditInput",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "RawRef": {
      "additionalProperties": false,
      "description": "Where a hit came from in the (byte-identical) raw artifact.",
      "properties": {
        "artifact": {
          "title": "Artifact",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "pointer": {
          "title": "Pointer",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "artifact_sha256",
        "pointer"
      ],
      "title": "RawRef",
      "type": "object"
    },
    "SecurityFinding": {
      "additionalProperties": false,
      "description": "A de-duplicated issue backed by at least one ToolHit (no evidence, no finding).",
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "default": "UNKNOWN"
        },
        "cwe_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Cwe Ids",
          "type": "array"
        },
        "file_path": {
          "title": "File Path",
          "type": "string"
        },
        "fingerprint": {
          "title": "Fingerprint",
          "type": "string"
        },
        "fingerprint_basis": {
          "enum": [
            "content",
            "location"
          ],
          "title": "Fingerprint Basis",
          "type": "string"
        },
        "fix_versions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fix Versions",
          "type": "array"
        },
        "hits": {
          "items": {
            "$ref": "#/$defs/ToolHit"
          },
          "minItems": 1,
          "title": "Hits",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "is_test_path": {
          "default": false,
          "title": "Is Test Path",
          "type": "boolean"
        },
        "issue_class": {
          "title": "Issue Class",
          "type": "string"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "owasp_2025": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owasp 2025"
        },
        "remediation": {
          "default": null,
          "title": "Remediation",
          "type": "null"
        },
        "risk": {
          "default": null,
          "title": "Risk",
          "type": "null"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "severity_basis": {
          "title": "Severity Basis",
          "type": "string"
        },
        "snippet": {
          "anyOf": [
            {
              "maxLength": 1500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        },
        "status": {
          "const": "open",
          "default": "open",
          "title": "Status",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "title": "Title",
          "type": "string"
        },
        "triage": {
          "default": null,
          "title": "Triage",
          "type": "null"
        }
      },
      "required": [
        "id",
        "fingerprint",
        "fingerprint_basis",
        "title",
        "issue_class",
        "file_path",
        "line_start",
        "line_end",
        "hits",
        "severity",
        "severity_basis"
      ],
      "title": "SecurityFinding",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO",
        "UNKNOWN"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SkippedFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "path"
      ],
      "title": "SkippedFile",
      "type": "object"
    },
    "SkippedResult": {
      "additionalProperties": false,
      "description": "A raw result that did not become a ToolHit (nothing is dropped silently).",
      "properties": {
        "pointer": {
          "title": "Pointer",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "pointer",
        "reason"
      ],
      "title": "SkippedResult",
      "type": "object"
    },
    "SourceInfo": {
      "additionalProperties": false,
      "description": "Three different facts that used to share one flag (`retained`):\n\nretained_at_scan  the scan copied the sanitized source into the audit directory (manifest;\n                  None when the manifest does not say, e.g. audits from before Phase 2A)\ncommitted         the source directory is part of a committed/shared artifact next to this\n                  audit (manifest; false unless stated, the committed baseline has none)\navailable         the source text was readable when this audit was normalized, so snippets\n                  and content fingerprints exist (computed, never read from the manifest)",
      "properties": {
        "available": {
          "default": false,
          "title": "Available",
          "type": "boolean"
        },
        "committed": {
          "default": false,
          "title": "Committed",
          "type": "boolean"
        },
        "injected_files": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Injected Files",
          "type": "array"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "retained_at_scan": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retained At Scan"
        }
      },
      "title": "SourceInfo",
      "type": "object"
    },
    "ToolCoverage": {
      "additionalProperties": false,
      "description": "What a tool actually looked at. `unknown` = the tool did not tell us, never 'complete'.",
      "properties": {
        "analyzed_files": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analyzed Files"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "skipped_files": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SkippedFile"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skipped Files"
        },
        "status": {
          "enum": [
            "known",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "status"
      ],
      "title": "ToolCoverage",
      "type": "object"
    },
    "ToolHit": {
      "additionalProperties": false,
      "description": "One result of one tool, reduced to location and metadata. No code text.",
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "default": "UNKNOWN"
        },
        "cwe_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Cwe Ids",
          "type": "array"
        },
        "file_path": {
          "title": "File Path",
          "type": "string"
        },
        "fix_versions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fix Versions",
          "type": "array"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "message": {
          "maxLength": 500,
          "title": "Message",
          "type": "string"
        },
        "package": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package"
        },
        "package_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Version"
        },
        "raw_ref": {
          "$ref": "#/$defs/RawRef"
        },
        "raw_severity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Severity"
        },
        "rule_id": {
          "maxLength": 300,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Name"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "required": [
        "tool",
        "rule_id",
        "message",
        "file_path",
        "line_start",
        "line_end",
        "raw_ref"
      ],
      "title": "ToolHit",
      "type": "object"
    },
    "ToolRun": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "hits": {
          "default": 0,
          "title": "Hits",
          "type": "integer"
        },
        "pinned_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pinned Version"
        },
        "raw_results": {
          "default": 0,
          "title": "Raw Results",
          "type": "integer"
        },
        "skipped_results": {
          "default": 0,
          "title": "Skipped Results",
          "type": "integer"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "unique_hits": {
          "default": 0,
          "title": "Unique Hits",
          "type": "integer"
        },
        "unresolved_requirements": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Unresolved Requirements",
          "type": "array"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "tool",
        "status"
      ],
      "title": "ToolRun",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Normalized audit record: mirrors manifest.json plus the findings derived from it.",
  "properties": {
    "audit_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audit Id"
    },
    "coverage": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolCoverage"
      },
      "title": "Coverage",
      "type": "array"
    },
    "created_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SecurityFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "input": {
      "$ref": "#/$defs/AuditInput",
      "default": {
        "commit": null,
        "file_count": null,
        "kind": null,
        "sha256": null,
        "source": null,
        "total_bytes": null
      }
    },
    "neutralized_files": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Neutralized Files",
      "type": "array"
    },
    "runner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runner"
    },
    "schema_version": {
      "default": "2",
      "title": "Schema Version",
      "type": "string"
    },
    "secaudit_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Secaudit Version"
    },
    "skipped_results": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SkippedResult"
      },
      "title": "Skipped Results",
      "type": "array"
    },
    "source": {
      "$ref": "#/$defs/SourceInfo",
      "default": {
        "available": false,
        "committed": false,
        "injected_files": [],
        "path": null,
        "retained_at_scan": null
      }
    },
    "tool_runs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolRun"
      },
      "title": "Tool Runs",
      "type": "array"
    },
    "unmapped_cwes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unmapped Cwes",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "title": "Audit",
  "type": "object"
}
