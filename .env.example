# secaudit environment template: variable NAMES only.
#
# NEVER commit real values. Copy this file to `.env` (which is git-ignored) and fill it in locally,
# or export the variables in your shell or CI secret store. Anything with a value in this file is
# a leak waiting to happen. See docs/SECURITY_POLICY.md, "Secrets policy".

# Credential for the LLM provider (Phase 3 onwards). Required only when LLM features are used.
ANTHROPIC_API_KEY=

# Model identifier the LLM layer should use.
SECAUDIT_LLM_MODEL=
